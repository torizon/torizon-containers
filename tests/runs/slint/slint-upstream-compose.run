docker run -d \
  --name slint \
  --volume "/dev:/dev" \
  --volume "/tmp:/tmp" \
  --volume "/run/udev:/run/udev" \
  --device-cgroup-rule "c 226:* rmw" \
  --device-cgroup-rule "c 13:* rmw" \
  --device-cgroup-rule "c 4:* rmw" \
  --device-cgroup-rule "c 29:* rmw" ghcr.io/slint-ui/slint/torizon-demos-armhf:latest
