docker run -d \
  --network host \
  --cap-add "CAP_SYS_TTY_CONFIG" \
  --volume "/dev:/dev" \
  --volume "/tmp:/tmp" \
  --volume "/run/udev/:/run/udev/" \
  --device-cgroup-rule "c 4:* rmw" \
  --device-cgroup-rule "c 13:* rmw" \
  --device-cgroup-rule "c 226:* rmw" $REGISTRY/torizon/weston-am69:stable-rc --developer

docker run -d \
  --volume "/tmp:/tmp" \
  --volume "/var/run/dbus:/var/run/dbus" \
  --volume "/dev/dri:/dev/dri" \
  --device-cgroup-rule "c 226:* rmw" \
  --security-opt "seccomp:unconfined" \
  --shm-size 256mb $REGISTRY/torizon/chromium-am69:stable-rc https://www.toradex.com
